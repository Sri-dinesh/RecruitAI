{
  "expo": {
    "name": "RecruitAI",
    "slug": "recruitai",
    "scheme": "recruitai",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "primaryColor": "#1B2A4A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F6F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recruitai.app",
      "associatedDomains": [
        "applinks:recruitaiofficial.vercel.app"
      ],
      "infoPlist": {
        "NSDocumentsFolderUsageDescription": "RecruitAI requires access to documents to ingest job descriptions and candidate resumes."
      }
    },
    "android": {
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.recruitai.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.recruitai.app",
      "predictiveBackGestureEnabled": true,
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "recruitaiofficial.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#F8F6F2"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.gorhom.bottomsheet.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-dontwarn com.facebook.react.**\n-dontwarn okhttp3.**"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b4d4925-923f-4934-8d03-06d5607c17ab"
      }
    }
  }
}
