{
  "expo": {
    "name": "RecruitAI",
    "slug": "recruitai",
    "scheme": "recruitai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#1B2A4A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F6F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recruitai.app",
      "associatedDomains": [
        "applinks:recruitaiofficial.vercel.app"
      ],
      "infoPlist": {
        "NSDocumentsFolderUsageDescription": "RecruitAI requires access to documents to ingest job descriptions and candidate resumes."
      }
    },
    "android": {
      "versionCode": 1,
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.recruitai.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.recruitai.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "recruitaiofficial.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-sharing",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ]
  }
}
