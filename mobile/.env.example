# ─── RecruitAI Mobile App Environment Configuration ───────────────────────────
# Copy this file to .env in the mobile directory.
# All variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# NEVER commit your actual .env or .env.local file to version control.

# ─── Backend API Configuration ───────────────────────────────────────────────
# Production Cloud Backend (FastAPI on Render):
EXPO_PUBLIC_BACKEND_URL=https://recruitai-vpbe.onrender.com

# For Android Emulator local testing, use:
# EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8000

# For physical device testing on local Wi-Fi, set your machine's LAN IP:
# EXPO_PUBLIC_DEV_LAN_URL=http://192.168.1.100:8000

# ─── Supabase Authentication ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
