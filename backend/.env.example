# Google Gemini Cloud API Key (LLM & Embeddings)
GEMINI_API_KEY=

# Search API Key
TAVILY_API_KEY=

# Supabase Vector Database Credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Get from Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=
# Set to "true" to bypass JWT auth in local development (no token needed)
USE_LOCAL_AUTH=true

# Job Fetching APIs 
INDIANAPI_JOBS_KEY=
SERPAPI_API_KEY=

# Resume Parsing APIs
APILAYER_API_KEY=

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
