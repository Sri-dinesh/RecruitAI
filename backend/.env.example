# ─── RecruitAI Backend (Node.js / Express) — Environment Template ────────────
# Loaded and validated by src/config/ (Phase 2). Feature code must read from
# the typed config module, never process.env directly.
#
# Copy to .env (git-ignored) and fill in real credentials.
# NEVER commit the actual .env file to version control.

# ─── Runtime / server ────────────────────────────────────────────────────────
NODE_ENV=development
# Environment name; `production` enables every gate.
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# Dev-only compatibility flag; has no effect on the built server.
RELOAD=true

# ─── Production gates ────────────────────────────────────────────────────────
# IS_PRODUCTION is derived from ENVIRONMENT/NODE_ENV; it is NOT an env var today.
LLM_DATA_USE_MODE=zero_retention_verified
LLM_KILL_SWITCH=false
# Run `npm run preflight` with the deployment environment before switching
# traffic. Production startup also refuses to listen when preflight fails.

# ─── LLM / AI providers ──────────────────────────────────────────────────────
# Google Gemini API key (required for the multi-agent graph, extraction, embeddings)
GEMINI_API_KEY=
# Compatibility alias; keep in sync if a tool reads it.
GOOGLE_API_KEY=
# Deprecated and unused by the Node LLM stack; accepted for compatibility.
GROQ_API_KEY=
# Tavily live search for salary/trend/web intelligence
TAVILY_API_KEY=

# ─── Supabase (PostgreSQL + pgvector) ────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# REQUIRED in production (32+ characters). HS256 verification is pinned; a
# missing or placeholder secret fails preflight and blocks startup.
SUPABASE_JWT_SECRET=
# Expected JWT `aud` claim; defaults to "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated

# ─── Database (direct TCP PostgreSQL for Drizzle — Phase 6) ──────────────────
# Postgres connection string, NOT the Supabase project URL/PostgREST endpoint.
# Supabase: Project Settings → Database → Connection string.
# SUPABASE_DB_URL is accepted as a fallback when DATABASE_URL is unset.
# REQUIRED in production: the SQLite fallback is blocked there.
DATABASE_URL=
SUPABASE_DB_URL=
# Bounded pool per Node instance. poolMax × replica count must stay below the
# Supavisor/PgBouncer transaction-pool ceiling (see Phase 22).
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# Local SQLite fallback for dev/test only; blocked in production.
SQLITE_FALLBACK_PATH=recruitai_fallback.db

# ─── Auth (development only) ─────────────────────────────────────────────────
# Set to true ONLY for offline local development; forced false in production.
USE_LOCAL_AUTH=false
LOCAL_DEV_USER_ID=e6cca9b2-49b8-4812-ac3a-3dfb770ea5a3

# ─── CORS (comma-separated) ──────────────────────────────────────────────────
# Production must list explicit https origins. Loopback origins fail preflight.
ALLOWED_ORIGINS=https://recruitaiofficial.vercel.app,https://recruitai.vercel.app,http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:8081

# ─── SMTP outreach ───────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Async chat jobs (Phase 14) ──────────────────────────────────────────────
# Leave REDIS_URL empty to use the in-memory, single-instance job manager.
# Set it to enable the BullMQ-backed queue with cross-instance SSE fan-out.
REDIS_URL=
JOB_QUEUE_NAME=recruitai-agent-jobs
JOB_TTL_SECONDS=3600
JOB_PER_USER_CONCURRENCY=2
JOB_WORKER_CONCURRENCY=10
JOB_EVENT_REPLAY_LIMIT=100

# ─── Operational retention (Phase 16) ────────────────────────────────────────
# The legacy backend never scheduled retention. Enable only when the deployment
# should sweep tenants automatically; the HTTP route and `npm run retention:run`
# remain available either way.
RETENTION_JOB_ENABLED=false
RETENTION_JOB_INTERVAL_SECONDS=86400
RETENTION_RAW_RESUME_TTL_DAYS=90
RETENTION_CHAT_TTL_DAYS=365

# ─── Logging and production hardening (Phase 19) ─────────────────────────────
# Structured JSON logs always go to stdout/stderr; the platform log drain
# indexes them. debug is for investigation only.
LOG_LEVEL=info
# Global per-IP request limiter. Defaults to true when ENVIRONMENT=production,
# false otherwise. Rejected requests get 429 + Retry-After.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=600
# Enable only when the service is reachable exclusively through a proxy that
# overwrites X-Forwarded-For (Render/Fly/ingress). Never enable on a directly
# exposed instance.
TRUST_PROXY=false

# ─── Dependency breakers and degraded mode (Phase 24) ────────────────────────
# Per-dependency circuit breakers (Gemini, Tavily, SMTP, Razorpay, Postgres,
# Redis). Set false only as an incident-triage bypass.
RESILIENCE_BREAKERS_ENABLED=true
# When Redis is configured but unreachable, keep serving sync traffic from
# in-memory state and return 503 for async chat enqueue (fleet queue is down).
# Default false preserves Phase 21 behavior: readiness 503 and drain.
REDIS_DEGRADED_MODE_ENABLED=false
# Reuse window for Redis readiness probes before pinging again.
REDIS_HEALTH_CACHE_MS=5000
