# ─── RecruitAI Backend Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your credentials.
# NEVER commit your actual .env file to version control.

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" in live environments (disables dev auth bypass)
ENVIRONMENT=development

# ─── LLM & Router Credentials ────────────────────────────────────────────────
# Google Gemini API Key (Required for multi-agent graph, extraction, and embeddings)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional: High-speed LLM fallback router)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Optional: Web intelligence search for market salaries & requirements)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Supabase PostgreSQL & Vector Store ───────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase JWT Secret (Required in production for cryptographic token verification)
# Get from: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ─── Authentication Configuration ─────────────────────────────────────────────
# Set to "true" ONLY for offline local development without Supabase
# In production, this is automatically forced to "false"
USE_LOCAL_AUTH=false

# Real registered Supabase user UUID used when USE_LOCAL_AUTH=true
LOCAL_DEV_USER_ID=e6cca9b2-49b8-4812-ac3a-3dfb770ea5a3

# ─── Job & Resume External APIs (Optional) ────────────────────────────────────
# IndianAPI for live job aggregation
INDIANAPI_JOBS_KEY=your_indianapi_jobs_key_here

# SerpAPI for Google Jobs live search
SERPAPI_API_KEY=your_serpapi_api_key_here

# APILayer Resume Parser API
APILAYER_API_KEY=your_apilayer_api_key_here

# ─── SMTP Email Dispatch (Optional) ──────────────────────────────────────────
# Used for candidate outreach and interview invitations
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_SENDER=recruiter@yourcompany.com
