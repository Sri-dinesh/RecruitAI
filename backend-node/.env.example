# ─── RecruitAI Backend (Node.js / Express) — Environment Template ────────────
# Loaded and validated by src/config/ (Phase 2). Feature code must read from
# the typed config module, never process.env directly.
#
# Copy to .env (git-ignored) and fill in real credentials.
# NEVER commit the actual .env file to version control.

# ─── Runtime / server ────────────────────────────────────────────────────────
NODE_ENV=development
# Mirrors ENVIRONMENT from the Python config (drives IS_PRODUCTION in Phase 2)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# Dev-only reload flag used by the current Python run.py bootstrap
RELOAD=true

# ─── Production gates ────────────────────────────────────────────────────────
# IS_PRODUCTION is derived from ENVIRONMENT/NODE_ENV; it is NOT an env var today.
LLM_DATA_USE_MODE=zero_retention_verified
LLM_KILL_SWITCH=false

# ─── LLM / AI providers ──────────────────────────────────────────────────────
# Google Gemini API key (required for the multi-agent graph, extraction, embeddings)
GEMINI_API_KEY=
# LangChain Google integrations may also read GOOGLE_API_KEY; keep in sync if used.
GOOGLE_API_KEY=
# Kept for parity with the Python config, which defines it but never reads it.
# Deprecated in the Node backend: Groq is not part of the target LLM stack.
GROQ_API_KEY=
# Tavily live search for salary/trend/web intelligence
TAVILY_API_KEY=

# ─── Supabase (PostgreSQL + pgvector) ────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Expected JWT `aud` claim. Python reads this via getattr, defaulting to
# "authenticated"; it is now an explicit config field.
SUPABASE_JWT_AUDIENCE=authenticated

# ─── Database (direct TCP PostgreSQL for Drizzle — Phase 6) ──────────────────
# Postgres connection string, NOT the Supabase project URL/PostgREST endpoint.
# Supabase: Project Settings → Database → Connection string.
# SUPABASE_DB_URL is accepted as a fallback when DATABASE_URL is unset.
DATABASE_URL=
SUPABASE_DB_URL=
# Bounded pool per Node instance. poolMax × replica count must stay below the
# Supavisor/PgBouncer transaction-pool ceiling (see Phase 22).
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# Local SQLite fallback for dev/test only; blocked in production.
SQLITE_FALLBACK_PATH=recruitai_fallback.db

# ─── Auth (development only) ─────────────────────────────────────────────────
# Set to true ONLY for offline local development; forced false in production.
USE_LOCAL_AUTH=false
LOCAL_DEV_USER_ID=e6cca9b2-49b8-4812-ac3a-3dfb770ea5a3

# ─── CORS (comma-separated) ──────────────────────────────────────────────────
ALLOWED_ORIGINS=https://recruitaiofficial.vercel.app,https://recruitai.vercel.app,http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:8081

# ─── SMTP outreach ───────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Planned for later phases (not read by any code yet) ─────────────────────
# TODO(Phase 21/23): Redis for the job bus, SSE fan-out, caches, breakers, rate limits.
REDIS_URL=
