# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Backend ──────────────────────────────────────────────────────────────────
# Local dev:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Production (Render):
# NEXT_PUBLIC_BACKEND_URL=https://your-render-service.onrender.com

# ─── Web3Forms (Contact / Deletion forms) ─────────────────────────────────────
# Create free access key at https://web3forms.com — set recipient to your support email
# Then add here and in Vercel environment variables:
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
